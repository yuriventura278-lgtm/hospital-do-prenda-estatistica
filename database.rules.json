{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin') || !data.exists()",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !root.child('users').exists()))",

        ".validate": "newData.hasChildren(['role', 'ativo'])",

        "role":     { ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'direcao' || newData.val() === 'supervisor' || newData.val() === 'chefe_servico' || newData.val() === 'enfermeiro_chefe' || newData.val() === 'medico' || newData.val() === 'enfermeiro' || newData.val() === 'tdt' || newData.val() === 'secretario' || newData.val() === 'tecnico_farmacia' || newData.val() === 'psicologo' || newData.val() === 'funcionario')" },
        "ativo":    { ".validate": "newData.isBoolean()" },
        "email":    { ".validate": "newData.isString()" },
        "cargo":    { ".validate": "newData.isString()" },
        "criadoEm": { ".validate": "newData.isNumber()" },
        "permissoes": { ".validate": true },

        "nome": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.isString()"
        },

        "foto": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.isString() && newData.val().length < 500000"
        },

        "ultimoAcesso": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "registos": {
      ".read": "auth != null",

      "$servico": {
        "$data": { ".write": "auth != null" }
      }
    },

    "registos_sistemas_locais": {
      ".read": "auth != null",
      "fecho_mes": {
        "$movimento": { "$mes": { ".write": "auth != null && !data.exists() && newData.exists()" } }
      },
      "fecho_mes_retificacoes": {
        "$movimento": { "$mes": { "$id": { ".write": "auth != null && !data.exists() && newData.exists()" } } }
      },
      "controlo_pacientes_saidas_nomes": {
        ".indexOn": ["nomeNorm", "apelidoNorm"],
        "$id": { ".write": "auth != null" }
      },
      "$modulo": {
        "$data": { ".write": "auth != null" }
      }
    },

    "registos_movimento": {
      ".read": "auth != null",

      "$servico": { ".write": "auth != null" }
    },

    "relatorios_mensais": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "registos_enf": {
      ".read": "auth != null",

      "$servico": {
        "$data": { ".write": "auth != null" }
      }
    },

    "avisos_integridade_enf": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$servico": {
        "$data": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['tipo', 'especialidade', 'data', 'detectadoEm'])"
        }
      }
    },

    "auditoria_registos": {
      ".read": "auth != null",

      "$pagina": {
        "$dia": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['ts', 'nome', 'acao'])"
          }
        }
      }
    },

    "audit_log": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$key": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['action', 'ts'])"
      }
    },

    "user_activity": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "$key": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['action', 'ts'])"
        }
      }
    },

    "inqueritos_satisfacao": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$dia": {
        "$area": {
          "$aparelho": {
            ".read": "$aparelho.matches(/^[A-Za-z0-9_-]{20,40}$/)",
            ".write": "newData.exists() && (!data.exists() || data.child('criado').val() > now - 172800000)",
            ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $area.matches(/^[a-z_]{2,40}$/) && $aparelho.matches(/^[A-Za-z0-9_-]{20,40}$/) && newData.hasChildren(['area', 'data', 'global', 'criado', 'ts']) && newData.child('area').val() === $area && newData.child('data').val() === $dia",

            "area":          { ".validate": "newData.isString()" },
            "areaNome":      { ".validate": "newData.isString() && newData.val().length <= 80" },
            "v":             { ".validate": "newData.isNumber()" },
            "data":          { ".validate": "newData.isString()" },
            "criado":        { ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() >= now - 300000 && newData.val() <= now + 300000))" },
            "ts":            { ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
            "editado":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "especialidade": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "perfil": {
              "$campo": { ".validate": "$campo.matches(/^[a-z_]{2,20}$/) && newData.isString() && newData.val().matches(/^[a-z0-9_-]{1,30}$/)" }
            },
            "recomenda":     { ".validate": "newData.val() === 'sim' || newData.val() === 'talvez' || newData.val() === 'nao'" },
            "global":        { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
            "notas": {
              "$q": { ".validate": "$q.matches(/^q[1-9][0-9]?$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" }
            },
            "sugestoes":     { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "$outro":        { ".validate": false }
          }
        }
      }
    },

    "urgencia_24h": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$dia": {
        "$servico": {
          ".write": "newData.exists() && (!data.exists() || data.child('criado').val() > now - 864000000)",
          ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $servico.matches(/^[a-z_]{2,40}$/) && newData.hasChildren(['servico', 'data', 'criado', 'ts', 'preenchidoPor']) && newData.child('servico').val() === $servico && newData.child('data').val() === $dia",

          "servico":       { ".validate": "newData.isString()" },
          "servicoNome":   { ".validate": "newData.isString() && newData.val().length <= 80" },
          "v":             { ".validate": "newData.isNumber()" },
          "data":          { ".validate": "newData.isString()" },
          "criado":        { ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || newData.val() >= now - 864000000) && newData.val() <= now + 300000" },
          "ts":            { ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
          "editado":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "preenchidoPor": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
          "categoria":     { ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{2,30}$/)" },
          "classificacao": { ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{2,30}$/)" },
          "contagens": {
            "$c": { ".validate": "$c.matches(/^[a-z0-9_]{1,40}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999" }
          },
          "textos": {
            "$t": { ".validate": "$t.matches(/^[a-z0-9_]{1,40}$/) && newData.isString() && newData.val().length <= 1000" }
          },
          "listas": {
            "$lista": {
              ".validate": "$lista.matches(/^[a-z0-9_]{1,40}$/)",
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/)",
                "$campo": { ".validate": "$campo.matches(/^[a-z_]{2,20}$/) && ((newData.isString() && newData.val().length <= 200) || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999))" }
              }
            }
          },
          "observacoes":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "$outro":        { ".validate": false }
        }
      }
    },

    "urgencia_24h_meta": {
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$dia": {
        "$servico": {
          ".read": true,
          ".write": "newData.exists() && (!data.exists() || data.child('criado').val() > now - 864000000)",
          ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $servico.matches(/^[a-z_]{2,40}$/) && newData.hasChildren(['preenchidoPor', 'criado', 'ts'])",
          "preenchidoPor": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
          "criado":        { ".validate": "newData.isNumber() && newData.val() <= now + 300000" },
          "ts":            { ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000" },
          "editado":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "$outro":        { ".validate": false }
        }
      }
    },

    "login_attempts": {
      ".read": true,

      "$emailKey": {
        ".write": true,
        ".validate": "newData.hasChildren(['count'])",

        "count":        { ".validate": "newData.isNumber()" },
        "firstAttempt": { ".validate": "newData.isNumber()" },
        "lastAttempt":  { ".validate": "newData.isNumber()" },
        "$outro":       { ".validate": false }
      }
    }
  }
}
